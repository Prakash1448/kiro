{
  "name": "kiro-project-intelligence",
  "version": "1.0.0",
  "description": "AI-powered project intelligence assistant for code analysis, review, and testing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:property": "jest --testMatch='**/tests/property/**/*.test.ts'",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.ts'",
    "analyze": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server/index.js",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": ["kiro", "project-intelligence", "code-analysis", "testing", "mcp"],
  "author": "Kiro University 2026",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
